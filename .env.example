# ---------------------------------------------------------------------------
# ToolScope environment configuration
# Copy to .env.local for local development. All values are optional —
# the site builds and runs with sensible placeholders when unset.
# ---------------------------------------------------------------------------

# Production site URL (no trailing slash). Used for canonical URLs, sitemap,
# hreflang, and Open Graph. Change this when the real domain is chosen.
NEXT_PUBLIC_SITE_URL=https://reviews.bidev.dev

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no banner, no scripts, no cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (the "google-site-verification"
# value from Search Console's HTML-tag method).
NEXT_PUBLIC_GSC_VERIFICATION=

# Newsletter endpoint (POST { email, consent }). Leave empty and the signup
# form shows an honest "not configured yet" notice instead of collecting data.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Set to "true" to render labeled advertising placeholders. Never renders
# real ads until an ad network script is added to components/monetization/ad-slot.tsx.
NEXT_PUBLIC_ADS_ENABLED=false

# logo.dev publishable token (public by design) — serves real product logos
# by domain on cards. Falls back to generated monograms when unset.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
